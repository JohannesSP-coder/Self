# Points the app at your backend. Expo Go / a physical device can't reach "localhost" (that's the
# device itself) - use your computer's LAN IP (e.g. http://192.168.1.20:4000) or a deployed URL.
# The iOS/Android simulators on the same machine as the server can keep the default.
EXPO_PUBLIC_API_URL="http://localhost:4000"
